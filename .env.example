QROS_ENV=dev
QROS_API_TOKEN=change-me
QROS_BROKER_ADAPTER=none
QROS_LIVE_TRADING_ENABLED=false
QROS_RESUME_ON_RESTART=false
QROS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# QROS_DATABASE_URL=sqlite:///C:/path/to/qros-prop/var/qros.db
# QROS_MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
# QROS_MT5_LOGIN=
# QROS_MT5_PASSWORD=
# QROS_MT5_SERVER=

# Real execution remains disabled until explicitly authorized on this host.
QROS_ORDER_EXECUTION_ENABLED=false
QROS_HALT_ACTION=flatten_managed
# QROS_NEWS_CALENDAR_PATH=C:/path/to/verified_news_calendar.json
# Paper parameters are explicit simulation assumptions, never broker observations.
# QROS_PAPER_INITIAL_BALANCE=10000
# QROS_PAPER_COMMISSION_PER_LOT_ROUND_TURN=7
# QROS_PAPER_SWAP_PER_LOT_DAY=0

# MT5 native calendar: install mt5/QROSCalendarExport.mq5 and attach on a dedicated chart.
# Paths are host-specific. Missing/stale exports block entries when enabled.
QROS_NEWS_FILTER_ENABLED=false
# QROS_NEWS_CALENDAR_PATH=C:/.../MQL5/Files/QROS/calendar.json
QROS_NEWS_MINUTES_BEFORE=5
QROS_NEWS_MINUTES_AFTER=5
QROS_NEWS_MIN_IMPORTANCE=2
QROS_NEWS_MAX_AGE_SECONDS=120
