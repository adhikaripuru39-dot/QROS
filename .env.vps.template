# ==============================================================================
# QROS-PROP Production Windows VPS Configuration Template
# ==============================================================================

# Runtime Environment
QROS_ENV=prod

# 64-character Bearer Token for Dashboard & Loopback API Authentication
# Replace with a unique random token (e.g. generated via python -c "import secrets; print(secrets.token_hex(32))")
QROS_API_TOKEN=REPLACE_WITH_YOUR_64_CHAR_HEX_TOKEN

# Broker Adapter (Set to 'mt5' for active execution or 'none' / 'paper' for dry-runs)
QROS_BROKER_ADAPTER=mt5

# Live Host Execution Guards
# Keep false during initial setup. Set to true ONLY when ready to trade.
QROS_LIVE_TRADING_ENABLED=false
QROS_ORDER_EXECUTION_ENABLED=false
QROS_RESUME_ON_RESTART=false

# Action taken when a risk limit or unexpected error is encountered
# Options: halt_new_entries | cancel_pending | flatten_managed | flatten_all
QROS_HALT_ACTION=flatten_managed

# Local Storage Paths (Ensure these are on local NVMe outside cloud syncing drives)
QROS_DATABASE_URL=sqlite:///C:/QROS-Runtime/var/qros.db
QROS_DATA_DIR=C:/QROS-Runtime/var/data
QROS_LOG_DIR=C:/QROS-Runtime/var/logs
QROS_CONFIG_DIR=C:/QROS-PROP/config

# MT5 Terminal Path (Leave commented to auto-detect the active FTMO MT5 instance)
# QROS_MT5_PATH=C:/Program Files/FTMO MetaTrader 5/terminal64.exe

# News Event Protection Filter (Fail-Closed, 10-Minute Buffer)
QROS_NEWS_FILTER_ENABLED=true
QROS_NEWS_MINUTES_BEFORE=10
QROS_NEWS_MINUTES_AFTER=10
QROS_NEWS_MIN_IMPORTANCE=2
QROS_NEWS_MAX_AGE_SECONDS=120

# News Calendar Path (Update with your specific MT5 data folder path)
# Format: C:/Users/<User>/AppData/Roaming/MetaQuotes/Terminal/<ID>/MQL5/Files/QROS/calendar.json
# QROS_NEWS_CALENDAR_PATH=C:/Users/Administrator/AppData/Roaming/MetaQuotes/Terminal/81A933A9AFC5DE3C23B15CAB19C63850/MQL5/Files/QROS/calendar.json

# Web Dashboard CORS Permissions
QROS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
